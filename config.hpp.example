static constexpr int BASE_CLUSTER_SIZE = 3;

static constexpr std::string INIT_CLUSTER[BASE_CLUSTER_SIZE] = {
    "68.183.202.86",
    "68.183.202.86",
    "68.183.202.86",
};

static constexpr size_t MAX_NODES = (BASE_CLUSTER_SIZE * 1.5) + 1; // the maximum number of nodes in the cluster that can be accomodated (used for writing cluster data to snapshot/state files)

static constexpr int MY_ID = 0;

static constexpr int CMD_SIZE = 4; // # of bytes that each command in the log occupies

static constexpr uint16_t SERVER_PORT = 6969;

enum class SocketType: uint8_t { TCP, UDP };
static constexpr SocketType SOCKET_TYPE = SocketType::UDP;

static constexpr size_t MAX_ENTRIES = 12; // maximum number of entries to append with any given AE RPC

static constexpr size_t SNAPSHOT_CHUNK_SIZE = 16; // in practice this should be something like 4 KiB

static constexpr uint EVENT_LOOP_THREADS = 1; // Must be > 0

static constexpr int SERVER_BACKLOG = 10; // max # of connections allowed to wait on the incoming queue

// Connection slab capacity. New accepts beyond this cap are closed immediately.
static constexpr size_t MAX_SERVER_CONNS = 16;

static constexpr size_t LOG_COMPACT_THRESHOLD = 4;

static constexpr int EPOLL_BATCH = 64; // max # of fds processed per loop iteration
static constexpr int UDP_RECV_BATCH = 32; // Max datagrams drained from the UDP listen socket per recvmmsg() call.

static constexpr size_t NODE_EVENT_LOOP_INBOX_RING_CAP = 512; // network thread -> main thread
static constexpr size_t NODE_CLIENT_INBOX_RING_CAP = 256; // client -> main thread
static constexpr size_t EVENT_LOOP_INBOX_RING_CAP = 1024; // main thread -> network thread

/* Timers */
static constexpr int MIN_ELECTION_TIMEOUT_MS = 150;
static constexpr int MAX_ELECTION_TIMEOUT_MS = 300;

static constexpr uint64_t MIN_ELECTION_TIMEOUT_NS = MIN_ELECTION_TIMEOUT_MS * 1000000;
static constexpr uint64_t MAX_ELECTION_TIMEOUT_NS = MAX_ELECTION_TIMEOUT_MS * 1000000;

// followers should see liveness before they start an election
static constexpr uint64_t HEARTBEAT_INTERVAL_MS{MIN_ELECTION_TIMEOUT_MS / 3};
static constexpr uint64_t HEARTBEAT_INTERVAL_NS = HEARTBEAT_INTERVAL_MS * 1000000;

static constexpr uint64_t RPC_TIMEOUT_MS{static_cast<uint64_t>(0.75 * MAX_ELECTION_TIMEOUT_MS)};
static constexpr uint64_t RPC_TIMEOUT_NS = RPC_TIMEOUT_MS * 1000000;

static constexpr uint64_t FLUSH_INTERVAL_MS{1500};
static constexpr uint64_t FLUSH_INTERVAL_NS = FLUSH_INTERVAL_MS * 1000000;
/* ---- */

static constexpr int MAX_TIMER_RETRIES = 4;

static constexpr const char* LOG_FILE_PATH = "/root/raft/persistence/log";
static constexpr const char* SNAPSHOT_FILE_PATH = "/root/raft/persistence/snapshot";
static constexpr const char* SNAPSHOT_TMP_FILE_PATH = "/root/raft/persistence/snapshot_tmp";
static constexpr const char* STATE_MACHINE_FILE_PATH = "/root/raft/persistence/state";
static constexpr const char* STATE_MACHINE_TMP_FILE_PATH = "/root/raft/persistence/state_tmp";

/* Don't change this */
static constexpr int BITS_PER_BYTE = 8;
static constexpr int BITS_PER_UINT64_T = 64;
static constexpr size_t CACHE_LINE_SIZE = std::hardware_destructive_interference_size;

static constexpr size_t MAX_CLUSTER_HEADER_SIZE = sizeof(uint64_t) + (((MAX_NODES-1) / BITS_PER_UINT64_T) + 1) * sizeof(uint64_t);

template <typename T>
size_t get_loop_idx(T n) {
    if constexpr ((EVENT_LOOP_THREADS > 0) && (EVENT_LOOP_THREADS & (EVENT_LOOP_THREADS-1)) == 0) {
        return n & (EVENT_LOOP_THREADS - 1);
    }
    return n % EVENT_LOOP_THREADS;
}

constexpr int stoi_constexpr(std::string_view sv) {
    int result = 0;
    for (char c : sv) {
        result = result * 10 + (c - '0');
    }
    return result;
}

using IPAddr = uint32_t;
// must convert to big endian
constexpr std::array<IPAddr, BASE_CLUSTER_SIZE> get_addrs() {
    std::array<IPAddr, BASE_CLUSTER_SIZE> addrs{};
    for (int i = 0; i < BASE_CLUSTER_SIZE; ++i) {
        auto split_view = INIT_CLUSTER[i] | std::views::split('.');
        auto it = std::ranges::begin(split_view);

        const std::string octet_str_1((*it).begin(), (*it).end());
        uint32_t octet = stoi_constexpr(octet_str_1);
        addrs[i] += octet;

        std::advance(it, 1);

        const std::string octet_str_2((*it).begin(), (*it).end());
        octet = stoi_constexpr(octet_str_2);
        addrs[i] += octet * 256;

        std::advance(it, 1);

        const std::string octet_str_3((*it).begin(), (*it).end());
        octet = stoi_constexpr(octet_str_3);
        addrs[i] += octet * 65536;

        std::advance(it, 1);

        const std::string octet_str_4((*it).begin(), (*it).end());
        octet = stoi_constexpr(octet_str_4);
        addrs[i] += octet * 16777216;

    }
    return addrs;
}
